    <style name="Theme.MiRuta" parent="android:Theme.Material.Light.NoActionBar" />
    <style name="Theme.MiRuta.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
